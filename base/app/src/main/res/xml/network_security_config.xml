<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is allowed so a Jellyfin server on the home network (http://192.168.x.x:8096,
         http://nas.local:8096…) can be reached: Android cannot scope this to private addresses.
         The app's own services all use https; the extensions' sandbox and Live Radio keep their
         own https-only rules in code (ExtensionRuntime, RadioBrowserApi.playable). -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
